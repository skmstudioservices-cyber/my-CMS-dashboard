---
const { crumb = ['Mission Control', 'Overview'] } = Astro.props;
---
<header class="sticky top-0 z-20 h-[72px] bg-base-100 border-b border-base-300 flex items-center gap-3 px-4 sm:px-8">
  <button id="navToggle" type="button" class="btn btn-sm btn-ghost lg:hidden" aria-label="Open navigation">☰</button>
  <div class="text-xs opacity-60 hidden sm:block">SKM Studio Network / <b class="opacity-100 text-base-content">{crumb[crumb.length - 1]}</b></div>
  <label class="ml-auto hidden md:flex items-center gap-2 bg-base-200 rounded-lg px-3 py-2 w-64">
    <span class="opacity-50">⌕</span>
    <input class="bg-transparent outline-none text-sm w-full" placeholder="Search…" aria-label="Global search" />
  </label>
  <span class="badge badge-success badge-sm hidden sm:inline-flex">● live</span>
  <button id="openFeedback" type="button" class="btn btn-primary btn-sm">＋ Give feedback</button>
  <div class="w-9 h-9 rounded-full bg-primary text-primary-content grid place-items-center text-xs font-bold" title="Account">SK</div>
</header>

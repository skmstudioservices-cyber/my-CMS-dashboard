---
// BLOCK:COMPONENT-BLOCK — wrap any block/element with a label + comment/colour tools.
interface Props { id: string; class?: string; }
const { id, class: cls = '' } = Astro.props;
---
<div data-block={id} class={cls}>
  <div class="blk-tools">
    <button class="btn btn-xs btn-primary" data-cmt={id} aria-label={'Comment on ' + id} title="Comment">💬</button>
    <button class="btn btn-xs btn-secondary" data-color={id} aria-label={'Colour ' + id} title="Colour">🎨</button>
    <button class="btn btn-xs" data-copy={id} aria-label={'Copy ' + id} title="Copy as prompt">📋</button>
    <button class="btn btn-xs btn-accent" data-send={id} aria-label={'Send ' + id} title="Send to agent">🚀</button>
  </div>
  <slot />
</div>

---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Topbar from '../components/Topbar.astro';
import Feedback from '../components/Feedback.astro';

interface Props { title?: string; active?: string; crumb?: string[]; }
const { title = 'Nexus CMS — Control Center', active = 'overview', crumb = ['Mission Control', 'Overview'] } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="skmlight">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="robots" content="noindex,nofollow" />
  <meta name="theme-color" content="#2563eb" />
  <link rel="manifest" href="/manifest.webmanifest" />
</head>
<body class="bg-base-200 text-base-content antialiased">
  <div class="min-h-screen grid lg:grid-cols-[248px_minmax(0,1fr)]">
    <Sidebar active={active} />
    <div class="min-w-0 flex flex-col">
      <Topbar crumb={crumb} />
      <main class="p-4 sm:p-8 w-full max-w-[1200px] mx-auto">
        <slot />
      </main>
    </div>
  </div>
  <Feedback />
</body>
</html>

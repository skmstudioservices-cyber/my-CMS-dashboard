---
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';

const rows = [
  ['Overview', 'Review system status in one place', 'Live'],
  ['Sites & Stacks', 'Connected projects and frameworks', 'Shell'],
  ['Data & Operations', 'Databases, KV, jobs and runs', 'Shell'],
  ['Global feedback', 'Collect typed or voice notes in one export', 'Live'],
];
---
<Base title="Phase 0 — Nexus CMS" active="phase-0" crumb={['Mission Control', 'Phase 0']}>
  <h1 class="text-2xl font-bold tracking-tight m-0 mb-1">Phase 0</h1>
  <p class="opacity-60 text-sm m-0 mb-6">Control-center foundation · same shell as the main dashboard</p>

  <Panel title="Workspace foundation" status="connected" subtitle="Phase 0 review checklist">
    <div class="overflow-x-auto">
      <table class="table table-sm">
        <thead><tr><th>Area</th><th>Purpose</th><th>State</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr><td class="font-medium">{r[0]}</td><td class="opacity-60">{r[1]}</td>
              <td><span class:list={["badge badge-sm", r[2] === 'Live' ? 'badge-success' : 'badge-ghost']}>{r[2]}</span></td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </Panel>

  <Panel title="Global feedback" status="connected" subtitle="Open the feedback button in the top bar — notes are tagged with the current route.">
    <p class="text-sm opacity-70 m-0">Typed and voice notes are collected, editable, and copied as one consolidated prompt.</p>
  </Panel>
</Base>

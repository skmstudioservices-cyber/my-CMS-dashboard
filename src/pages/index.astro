---
// BLOCK:PAGE-WIREFRAME — a playground of flexible containers + columns.
// Arrange boxes to sketch a layout, then "Copy code" and send it — I build it
// fully responsive. No backend needed.
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en" data-theme="skmlight">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nexus CMS — wireframe playground</title>
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#2563eb" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" href="/icon.svg" type="image/svg+xml" />
</head>
<body class="bg-base-200 text-base-content">
  <div class="flex min-h-screen flex-col">
    <!-- BLOCK:HEADER -->
    <header class="navbar sticky top-0 z-30 border-b border-base-300 bg-base-100/90 px-4 backdrop-blur">
      <div class="flex-1">
        <span class="text-lg font-bold">🧩 Wireframe playground</span>
        <span class="ml-2 text-xs opacity-60">arrange boxes → copy code → send to me</span>
      </div>
      <div class="flex-none gap-2">
        <button class="btn btn-sm" id="btnClear">Clear</button>
        <button class="btn btn-sm" id="btnCode">📋 Copy code</button>
        <button class="btn btn-sm btn-primary" id="btnPrompt">🚀 Copy as prompt</button>
      </div>
    </header>

    <div class="flex flex-1 flex-col lg:flex-row">
      <!-- BLOCK:PALETTE -->
      <aside class="w-full shrink-0 border-b border-base-300 bg-base-100 p-4 lg:w-72 lg:border-b-0 lg:border-r" data-block="palette">
        <div class="text-xs font-semibold uppercase tracking-wide opacity-60">Add a block</div>
        <div id="palette" class="mt-3 grid grid-cols-2 gap-2"></div>
        <div class="mt-4 text-xs opacity-60">
          Click a block to add it to the canvas. Reorder with ↑ ↓, remove with ✕.
          When happy: <b>Copy code</b> and paste it to me.
        </div>
      </aside>

      <!-- BLOCK:CANVAS -->
      <main class="min-w-0 flex-1 p-4 lg:p-6">
        <div class="mb-3 text-xs font-semibold uppercase tracking-wide opacity-60">Canvas</div>
        <div id="canvas" class="flex flex-col gap-3" data-block="canvas">
          <div class="rounded-box border-2 border-dashed border-base-300 p-10 text-center opacity-60">
            Empty — add blocks from the left
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- BLOCK:DIALOG-CODE -->
  <dialog id="dlgCode" class="modal">
    <div class="modal-box max-w-3xl">
      <h3 class="text-lg font-bold">Generated code</h3>
      <p class="mt-1 text-sm opacity-60">Commented HTML — send this to me and I'll build it fully responsive.</p>
      <pre id="codeOut" class="mt-3 max-h-96 overflow-auto rounded-box border border-base-300 bg-base-200 p-4 text-xs"></pre>
      <div class="modal-action">
        <button class="btn btn-ghost" data-close>Close</button>
        <button class="btn btn-primary" id="btnCopyCode">📋 Copy</button>
      </div>
    </div>
  </dialog>

  <div id="toast" class="toast toast-end z-50 hidden"><div class="alert alert-info"><span id="toastMsg"></span></div></div>

  <script>
    // ===== BLOCK:PLAYGROUND-ENGINE =====
    const $ = (s, r = document) => r.querySelector(s);
    function toast(m) { $('#toastMsg').textContent = m; const t = $('#toast'); t.classList.remove('hidden'); clearTimeout(t._t); t._t = setTimeout(() => t.classList.add('hidden'), 2400); }

    // each palette entry = a flexible primitive the user can drop in
    const TYPES = [
      { type: 'container', label: '📦 Container', hint: 'full-width box' },
      { type: 'row', label: '➡️ Row', hint: 'flex row' },
      { type: 'grid2', label: '▥ Grid 2', hint: '2 columns' },
      { type: 'grid3', label: '▦ Grid 3', hint: '3 columns' },
      { type: 'grid4', label: '▩ Grid 4', hint: '4 columns' },
      { type: 'card', label: '🃏 Card', hint: 'panel' },
      { type: 'stat', label: '📊 Stat', hint: 'KPI number' },
      { type: 'table', label: '▤ Table', hint: 'data table' },
      { type: 'header', label: '⬛ Header', hint: 'top bar' },
      { type: 'sidebar', label: '◧ Sidebar', hint: 'left column' },
      { type: 'button', label: '🔘 Button', hint: 'action' },
      { type: 'text', label: '✏️ Text', hint: 'paragraph' },
      { type: 'image', label: '🖼️ Image', hint: 'media box' },
      { type: 'spacer', label: '↕️ Spacer', hint: 'vertical gap' },
    ];
    const PREVIEW = {
      container: '<div class="rounded border-2 border-dashed border-base-300 p-4 text-xs opacity-60">Container — full width</div>',
      row: '<div class="flex gap-2"><div class="flex-1 rounded border-2 border-dashed border-base-300 p-3 text-xs opacity-60">item</div><div class="flex-1 rounded border-2 border-dashed border-base-300 p-3 text-xs opacity-60">item</div><div class="flex-1 rounded border-2 border-dashed border-base-300 p-3 text-xs opacity-60">item</div></div>',
      grid2: '<div class="grid grid-cols-2 gap-2"><div class="rounded border-2 border-dashed border-base-300 p-4 text-xs opacity-60">1</div><div class="rounded border-2 border-dashed border-base-300 p-4 text-xs opacity-60">2</div></div>',
      grid3: '<div class="grid grid-cols-3 gap-2"><div class="rounded border-2 border-dashed border-base-300 p-4 text-xs opacity-60">1</div><div class="rounded border-2 border-dashed border-base-300 p-4 text-xs opacity-60">2</div><div class="rounded border-2 border-dashed border-base-300 p-4 text-xs opacity-60">3</div></div>',
      grid4: '<div class="grid grid-cols-4 gap-2"><div class="rounded border-2 border-dashed border-base-300 p-4 text-xs opacity-60">1</div><div class="rounded border-2 border-dashed border-base-300 p-4 text-xs opacity-60">2</div><div class="rounded border-2 border-dashed border-base-300 p-4 text-xs opacity-60">3</div><div class="rounded border-2 border-dashed border-base-300 p-4 text-xs opacity-60">4</div></div>',
      card: '<div class="card bg-base-100 border border-base-300 shadow-sm"><div class="card-body"><div class="card-title text-sm">Card title</div><div class="h-10 rounded bg-base-200"></div></div></div>',
      stat: '<div class="stats bg-base-100 border border-base-300 shadow-sm"><div class="stat"><div class="stat-title text-xs">Metric</div><div class="stat-value text-2xl">1,234</div></div></div>',
      table: '<div class="overflow-x-auto rounded-box border border-base-300"><table class="table table-sm"><thead><tr><th>A</th><th>B</th></tr></thead><tbody><tr><td>—</td><td>—</td></tr></tbody></table></div>',
      header: '<div class="flex items-center justify-between rounded border-2 border-dashed border-base-300 p-3 text-xs opacity-60"><span>Header / title</span><span>actions</span></div>',
      sidebar: '<div class="flex gap-2"><div class="w-32 rounded border-2 border-dashed border-base-300 p-4 text-xs opacity-60">sidebar</div><div class="flex-1 rounded border-2 border-dashed border-base-300 p-4 text-xs opacity-60">content</div></div>',
      button: '<div><button class="btn btn-sm btn-primary">Button</button></div>',
      text: '<p class="text-sm opacity-60">A paragraph of text goes here.</p>',
      image: '<div class="flex h-24 items-center justify-center rounded border-2 border-dashed border-base-300 text-xs opacity-60">image / media</div>',
      spacer: '<div class="h-8 rounded border-2 border-dashed border-base-300"></div>',
    };
    // exported code per type (commented, data-block named)
    const CODE = {
      container: (n) => `<!-- BLOCK:${n} -->\n<section class="container mx-auto px-4 py-6" data-block="${n}">\n  <!-- content -->\n</section>`,
      row: (n) => `<!-- BLOCK:${n} -->\n<div class="flex flex-col gap-4 md:flex-row" data-block="${n}">\n  <div class="flex-1"><!-- item --></div>\n  <div class="flex-1"><!-- item --></div>\n  <div class="flex-1"><!-- item --></div>\n</div>`,
      grid2: (n) => `<!-- BLOCK:${n} -->\n<div class="grid grid-cols-1 gap-4 sm:grid-cols-2" data-block="${n}">\n  <div><!-- 1 --></div><div><!-- 2 --></div>\n</div>`,
      grid3: (n) => `<!-- BLOCK:${n} -->\n<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-block="${n}">\n  <div><!-- 1 --></div><div><!-- 2 --></div><div><!-- 3 --></div>\n</div>`,
      grid4: (n) => `<!-- BLOCK:${n} -->\n<div class="grid grid-cols-2 gap-4 lg:grid-cols-4" data-block="${n}">\n  <div><!-- 1 --></div><div><!-- 2 --></div><div><!-- 3 --></div><div><!-- 4 --></div>\n</div>`,
      card: (n) => `<!-- BLOCK:${n} -->\n<div class="card bg-base-100 border border-base-300 shadow-sm" data-block="${n}">\n  <div class="card-body"><h2 class="card-title"><!-- title --></h2><!-- body --></div>\n</div>`,
      stat: (n) => `<!-- BLOCK:${n} -->\n<div class="stats bg-base-100 border border-base-300 shadow-sm" data-block="${n}">\n  <div class="stat"><div class="stat-title"><!-- label --></div><div class="stat-value"><!-- value --></div></div>\n</div>`,
      table: (n) => `<!-- BLOCK:${n} -->\n<div class="overflow-x-auto rounded-box border border-base-300" data-block="${n}">\n  <table class="table"><thead><tr><th><!-- col --></th></tr></thead><tbody><tr><td><!-- cell --></td></tr></tbody></table>\n</div>`,
      header: (n) => `<!-- BLOCK:${n} -->\n<header class="flex items-center justify-between border-b border-base-300 px-4 py-3" data-block="${n}">\n  <span><!-- title --></span><div><!-- actions --></div>\n</header>`,
      sidebar: (n) => `<!-- BLOCK:${n} -->\n<div class="flex flex-col gap-4 lg:flex-row" data-block="${n}">\n  <aside class="w-full lg:w-64"><!-- nav --></aside>\n  <main class="min-w-0 flex-1"><!-- content --></main>\n</div>`,
      button: (n) => `<!-- BLOCK:${n} -->\n<button class="btn btn-primary" data-block="${n}"><!-- label --></button>`,
      text: (n) => `<!-- BLOCK:${n} -->\n<p class="text-base-content/80" data-block="${n}"><!-- text --></p>`,
      image: (n) => `<!-- BLOCK:${n} -->\n<img src="" alt="" class="w-full rounded-box" data-block="${n}" />`,
      spacer: (n) => `<!-- BLOCK:${n} -->\n<div class="h-8" data-block="${n}"></div>`,
    };

    let blocks = [];   // { id, type }
    let seq = 0;

    $('#palette').innerHTML = TYPES.map((t) => '<button class="btn btn-sm justify-start" data-add="' + t.type + '" title="' + t.hint + '">' + t.label + '</button>').join('');
    $('#palette').addEventListener('click', (e) => { const b = e.target.closest('[data-add]'); if (b) { seq++; blocks.push({ id: b.dataset.add + '-' + seq, type: b.dataset.add }); render(); } });

    function render() {
      const c = $('#canvas');
      if (!blocks.length) { c.innerHTML = '<div class="rounded-box border-2 border-dashed border-base-300 p-10 text-center opacity-60">Empty — add blocks from the left</div>'; return; }
      c.innerHTML = blocks.map((b, i) => {
        const t = TYPES.find((x) => x.type === b.type);
        return '<div class="relative rounded-box border border-base-300 bg-base-100 p-3 shadow-sm" data-block="' + b.id + '">' +
          '<div class="mb-2 flex items-center justify-between"><span class="font-mono text-[11px] opacity-60">' + b.id + ' · ' + (t ? t.hint : '') + '</span>' +
          '<span class="flex gap-1"><button class="btn btn-xs" data-up="' + i + '" title="Up">↑</button><button class="btn btn-xs" data-down="' + i + '" title="Down">↓</button><button class="btn btn-xs btn-error" data-del="' + i + '" title="Remove">✕</button></span></div>' +
          PREVIEW[b.type] + '</div>';
      }).join('');
    }
    $('#canvas').addEventListener('click', (e) => {
      const up = e.target.closest('[data-up]'), dn = e.target.closest('[data-down]'), del = e.target.closest('[data-del]');
      if (up) { const i = +up.dataset.up; if (i > 0) { [blocks[i - 1], blocks[i]] = [blocks[i], blocks[i - 1]]; render(); } }
      else if (dn) { const i = +dn.dataset.down; if (i < blocks.length - 1) { [blocks[i + 1], blocks[i]] = [blocks[i], blocks[i + 1]]; render(); } }
      else if (del) { blocks.splice(+del.dataset.del, 1); render(); }
    });
    $('#btnClear').addEventListener('click', () => { blocks = []; render(); });

    const genCode = () => '<!-- Nexus CMS — wireframe sketch. Build this fully responsive. -->\n\n' +
      (blocks.length ? blocks.map((b) => CODE[b.type](b.id)).join('\n\n') : '<!-- (empty) -->');
    $('#btnCode').addEventListener('click', () => { $('#codeOut').textContent = genCode(); $('#dlgCode').showModal(); });
    $('#btnCopyCode').addEventListener('click', () => navigator.clipboard.writeText(genCode()).then(() => toast('Code copied')));
    $('#btnPrompt').addEventListener('click', () => {
      const p = 'Build this dashboard layout fully responsive (mobile → desktop). Use Astro + Tailwind + daisyUI. Keep the data-block names.\n\n' + genCode();
      navigator.clipboard.writeText(p).then(() => toast('Prompt copied'));
    });
    document.addEventListener('click', (e) => { if (e.target.closest('[data-close]')) e.target.closest('dialog').close(); });

    render();
  </script>
</body>
</html>

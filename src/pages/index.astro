---
// BLOCK:PAGE-WIREFRAME — a drag-and-drop wireframe builder (Elementor-style).
// Add blocks, drag to move/nest, then "Copy code" (commented HTML) and send it.
// I build the real thing fully responsive. No backend.
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en" data-theme="skmlight">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nexus CMS — wireframe builder</title>
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#2563eb" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" href="/icon.svg" type="image/svg+xml" />
  <style>
    /* builder-only chrome (custom CSS is fine here) */
    .wf-node { position: relative; border: 1px solid var(--color-base-300); border-radius: 0.5rem; background: var(--color-base-100); margin: 2px 0; }
    .wf-bar { display: flex; align-items: center; gap: 6px; padding: 4px 6px; border-bottom: 1px dashed var(--color-base-300); }
    .wf-handle { cursor: grab; font-size: 14px; opacity: .5; padding: 0 3px; }
    .wf-handle:active { cursor: grabbing; }
    .wf-body { padding: 6px; }
    .wf-children { padding: 4px; min-height: 34px; }
    .wf-empty { border: 1px dashed var(--color-base-300); border-radius: 0.4rem; padding: 8px; text-align: center; font-size: 11px; opacity: .5; }
    .drop-slot { height: 6px; border-radius: 4px; transition: background .1s, height .1s; }
    .drop-slot.over { height: 26px; background: color-mix(in oklab, var(--color-primary) 30%, transparent); border: 1px dashed var(--color-primary); }
    .dragging { opacity: .4; }
    .wf-root.over { outline: 2px dashed var(--color-primary); }
  </style>
</head>
<body class="bg-base-200 text-base-content">
  <div class="flex min-h-screen flex-col">
    <!-- BLOCK:HEADER -->
    <header class="navbar sticky top-0 z-30 border-b border-base-300 bg-base-100/90 px-4 backdrop-blur">
      <div class="flex-1">
        <span class="text-lg font-bold">🧩 Wireframe builder</span>
        <span class="ml-2 text-xs opacity-60">drag ⠿ to move · drop into a container to nest</span>
      </div>
      <div class="flex-none gap-2">
        <button class="btn btn-sm" id="btnClear">Clear</button>
        <button class="btn btn-sm" id="btnCode">📋 Copy code</button>
        <button class="btn btn-sm btn-primary" id="btnPrompt">🚀 Copy as prompt</button>
      </div>
    </header>

    <div class="flex flex-1 flex-col lg:flex-row">
      <!-- BLOCK:PALETTE -->
      <aside class="w-full shrink-0 border-b border-base-300 bg-base-100 p-4 lg:w-72 lg:border-b-0 lg:border-r">
        <div class="text-xs font-semibold uppercase tracking-wide opacity-60">Blocks — click to add</div>
        <div id="palette" class="mt-3 grid grid-cols-2 gap-2"></div>
        <div class="mt-4 text-xs opacity-60">
          <b>Move:</b> drag the ⠿ handle. <b>Nest:</b> drop onto a dashed zone inside a container/row/grid.
          <b>Then:</b> Copy code → paste it to me.
        </div>
      </aside>

      <!-- BLOCK:CANVAS -->
      <main class="min-w-0 flex-1 p-4 lg:p-6">
        <div class="mb-3 text-xs font-semibold uppercase tracking-wide opacity-60">Canvas</div>
        <div id="canvas" class="wf-root rounded-box border-2 border-dashed border-base-300 p-3"></div>
      </main>
    </div>
  </div>

  <!-- BLOCK:DIALOG-CODE -->
  <dialog id="dlgCode" class="modal">
    <div class="modal-box max-w-3xl">
      <h3 class="text-lg font-bold">Generated code</h3>
      <p class="mt-1 text-sm opacity-60">Commented, nested HTML — send this to me and I'll build it fully responsive.</p>
      <pre id="codeOut" class="mt-3 max-h-96 overflow-auto rounded-box border border-base-300 bg-base-200 p-4 text-xs"></pre>
      <div class="modal-action">
        <button class="btn btn-ghost" data-close>Close</button>
        <button class="btn btn-primary" id="btnCopyCode">📋 Copy</button>
      </div>
    </div>
  </dialog>

  <div id="toast" class="toast toast-end z-50 hidden"><div class="alert alert-info"><span id="toastMsg"></span></div></div>

  <script>
    // ===== BLOCK:BUILDER-ENGINE (drag-drop tree) =====
    const $ = (s, r = document) => r.querySelector(s);
    function toast(m) { $('#toastMsg').textContent = m; const t = $('#toast'); t.classList.remove('hidden'); clearTimeout(t._t); t._t = setTimeout(() => t.classList.add('hidden'), 2400); }

    const CONTAINERS = new Set(['container', 'row', 'grid2', 'grid3', 'grid4', 'card', 'sidebar', 'header']);
    const TYPES = [
      { type: 'container', label: '📦 Container', hint: 'full-width box' },
      { type: 'row', label: '➡️ Row', hint: 'side-by-side' },
      { type: 'grid2', label: '▥ Grid 2', hint: '2 columns' },
      { type: 'grid3', label: '▦ Grid 3', hint: '3 columns' },
      { type: 'grid4', label: '▩ Grid 4', hint: '4 columns' },
      { type: 'card', label: '🃏 Card', hint: 'panel' },
      { type: 'stat', label: '📊 Stat', hint: 'KPI' },
      { type: 'table', label: '▤ Table', hint: 'data' },
      { type: 'header', label: '⬛ Header', hint: 'top bar' },
      { type: 'sidebar', label: '◧ Sidebar', hint: 'nav + content' },
      { type: 'button', label: '🔘 Button', hint: 'action' },
      { type: 'text', label: '✏️ Text', hint: 'paragraph' },
      { type: 'image', label: '🖼️ Image', hint: 'media' },
      { type: 'spacer', label: '↕️ Spacer', hint: 'gap' },
    ];
    const PREVIEW = {
      stat: '<div class="stats bg-base-100 border border-base-300"><div class="stat"><div class="stat-title text-xs">Metric</div><div class="stat-value text-xl">1,234</div></div></div>',
      table: '<div class="overflow-x-auto border border-base-300 rounded"><table class="table table-sm"><thead><tr><th>A</th><th>B</th></tr></thead><tbody><tr><td>—</td><td>—</td></tr></tbody></table></div>',
      button: '<button class="btn btn-sm btn-primary">Button</button>',
      text: '<p class="text-sm opacity-60">A paragraph of text.</p>',
      image: '<div class="flex h-20 items-center justify-center rounded border border-dashed border-base-300 text-xs opacity-60">image / media</div>',
      spacer: '<div class="h-6 rounded border border-dashed border-base-300"></div>',
    };
    const CODE = {
      container: (n, inner) => `<!-- BLOCK:${n} -->\n<section class="container mx-auto px-4 py-6" data-block="${n}">\n${inner || '  <!-- content -->'}\n</section>`,
      row: (n, inner) => `<!-- BLOCK:${n} -->\n<div class="flex flex-col gap-4 md:flex-row" data-block="${n}">\n${inner || '  <!-- items -->'}\n</div>`,
      grid2: (n, inner) => `<!-- BLOCK:${n} -->\n<div class="grid grid-cols-1 gap-4 sm:grid-cols-2" data-block="${n}">\n${inner || '  <!-- cells -->'}\n</div>`,
      grid3: (n, inner) => `<!-- BLOCK:${n} -->\n<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-block="${n}">\n${inner || '  <!-- cells -->'}\n</div>`,
      grid4: (n, inner) => `<!-- BLOCK:${n} -->\n<div class="grid grid-cols-2 gap-4 lg:grid-cols-4" data-block="${n}">\n${inner || '  <!-- cells -->'}\n</div>`,
      card: (n, inner) => `<!-- BLOCK:${n} -->\n<div class="card bg-base-100 border border-base-300 shadow-sm" data-block="${n}">\n  <div class="card-body">\n${inner || '    <!-- body -->'}\n  </div>\n</div>`,
      header: (n, inner) => `<!-- BLOCK:${n} -->\n<header class="flex items-center justify-between border-b border-base-300 px-4 py-3" data-block="${n}">\n${inner || '  <!-- title / actions -->'}\n</header>`,
      sidebar: (n, inner) => `<!-- BLOCK:${n} -->\n<div class="flex flex-col gap-4 lg:flex-row" data-block="${n}">\n${inner || '  <!-- nav + content -->'}\n</div>`,
      stat: (n) => `<!-- BLOCK:${n} -->\n<div class="stat bg-base-100 border border-base-300" data-block="${n}"><div class="stat-title"><!-- label --></div><div class="stat-value"><!-- value --></div></div>`,
      table: (n) => `<!-- BLOCK:${n} -->\n<div class="overflow-x-auto border border-base-300" data-block="${n}"><table class="table"><thead><tr><th><!-- col --></th></tr></thead><tbody><tr><td><!-- cell --></td></tr></tbody></table></div>`,
      button: (n) => `<!-- BLOCK:${n} -->\n<button class="btn btn-primary" data-block="${n}"><!-- label --></button>`,
      text: (n) => `<!-- BLOCK:${n} -->\n<p class="text-base-content/80" data-block="${n}"><!-- text --></p>`,
      image: (n) => `<!-- BLOCK:${n} -->\n<img src="" alt="" class="w-full rounded-box" data-block="${n}" />`,
      spacer: (n) => `<!-- BLOCK:${n} -->\n<div class="h-6" data-block="${n}"></div>`,
    };

    let tree = [], seq = 0, dragId = null;

    const mk = (type) => { seq++; return { id: type + '-' + seq, type, children: [] }; };
    function find(id, list = tree, parentId = 'root') {
      for (let i = 0; i < list.length; i++) {
        if (list[i].id === id) return { node: list[i], list, index: i, parentId };
        const r = find(id, list[i].children, list[i].id);
        if (r) return r;
      }
      return null;
    }
    function isDescendant(ancestorId, id) { const f = find(ancestorId); if (!f) return false; const walk = (n) => n.id === id || n.children.some(walk); return f.node.children.some(walk); }

    const slot = (parentId, index) => '<div class="drop-slot" data-parent="' + parentId + '" data-index="' + index + '"></div>';
    function renderList(list, parentId) { return list.map((n, i) => slot(parentId, i) + renderNode(n)).join('') + slot(parentId, list.length); }
    function renderNode(n) {
      const isC = CONTAINERS.has(n.type);
      const body = isC
        ? '<div class="wf-children" data-zone="' + n.id + '">' + (n.children.length ? renderList(n.children, n.id) : '<div class="wf-empty">drop here</div>' + slot(n.id, 0)) + '</div>'
        : '<div class="wf-body">' + (PREVIEW[n.type] || '') + '</div>';
      return '<div class="wf-node" data-id="' + n.id + '">' +
        '<div class="wf-bar"><span class="wf-handle" data-drag="' + n.id + '" title="Drag to move">⠿</span>' +
        '<span class="font-mono text-[11px] opacity-60">' + n.id + '</span>' +
        '<button class="btn btn-xs btn-error ml-auto" data-del="' + n.id + '" title="Remove">✕</button></div>' + body + '</div>';
    }
    function render() {
      const c = $('#canvas');
      c.innerHTML = tree.length ? renderList(tree, 'root') : '<div class="wf-empty">Empty — add blocks from the left</div>' + slot('root', 0);
    }

    // palette
    $('#palette').innerHTML = TYPES.map((t) => '<button class="btn btn-sm justify-start" data-add="' + t.type + '" title="' + t.hint + '">' + t.label + '</button>').join('');
    $('#palette').addEventListener('click', (e) => { const b = e.target.closest('[data-add]'); if (b) { tree.push(mk(b.dataset.add)); render(); } });

    // remove
    $('#canvas').addEventListener('click', (e) => { const d = e.target.closest('[data-del]'); if (!d) return; const f = find(d.dataset.del); if (f) { f.list.splice(f.index, 1); render(); } });

    // drag — pointer based (works on touch + desktop, and testable)
    let overSlot = null;
    document.addEventListener('pointerdown', (e) => {
      const h = e.target.closest('[data-drag]');
      if (!h) return;
      e.preventDefault();
      dragId = h.dataset.drag;
      h.closest('.wf-node')?.classList.add('dragging');
      document.body.style.cursor = 'grabbing';
    });
    document.addEventListener('pointermove', (e) => {
      if (!dragId) return;
      const el = document.elementFromPoint(e.clientX, e.clientY);
      const s = el && el.closest ? el.closest('.drop-slot') : null;
      if (s !== overSlot) {
        document.querySelectorAll('.drop-slot.over').forEach((n) => n.classList.remove('over'));
        overSlot = s;
        if (s) s.classList.add('over');
      }
    });
    document.addEventListener('pointerup', () => {
      if (!dragId) return;
      const id = dragId; dragId = null;
      document.body.style.cursor = '';
      document.querySelectorAll('.dragging').forEach((n) => n.classList.remove('dragging'));
      const s = overSlot; overSlot = null;
      document.querySelectorAll('.drop-slot.over').forEach((n) => n.classList.remove('over'));
      if (!s) return;
      const parentId = s.dataset.parent, index = +s.dataset.index;
      if (parentId !== 'root' && (parentId === id || isDescendant(id, parentId))) { toast('Cannot drop into itself'); return; }
      const f = find(id); if (!f) return;
      const [node] = f.list.splice(f.index, 1);
      const target = parentId === 'root' ? tree : (find(parentId)?.node.children || tree);
      let idx = index;
      if (f.parentId === parentId && f.index < index) idx = Math.max(0, index - 1);
      target.splice(Math.min(idx, target.length), 0, node);
      render();
    });

    $('#btnClear').addEventListener('click', () => { tree = []; render(); });

    function genList(list, depth) {
      const pad = '  '.repeat(depth);
      return list.map((n) => genNode(n, depth)).join('\n');
    }
    function genNode(n, depth) {
      const pad = '  '.repeat(depth);
      const inner = n.children.length ? genList(n.children, depth + 1) : '';
      return CODE[n.type](n.id, inner).split('\n').map((l) => l ? pad + l : l).join('\n');
    }
    const genCode = () => '<!-- Nexus CMS — wireframe sketch. Build this fully responsive. -->\n\n' + (tree.length ? genList(tree, 0) : '<!-- (empty) -->');

    $('#btnCode').addEventListener('click', () => { $('#codeOut').textContent = genCode(); $('#dlgCode').showModal(); });
    $('#btnCopyCode').addEventListener('click', () => navigator.clipboard.writeText(genCode()).then(() => toast('Code copied')));
    $('#btnPrompt').addEventListener('click', () => navigator.clipboard.writeText('Build this dashboard layout fully responsive (mobile → desktop). Use Astro + Tailwind + daisyUI. Keep the data-block names.\n\n' + genCode()).then(() => toast('Prompt copied')));
    document.addEventListener('click', (e) => { if (e.target.closest('[data-close]')) e.target.closest('dialog').close(); });

    render();
  </script>
</body>
</html>

---
import Base from '../layouts/Base.astro';
---
<Base title="Nexus CMS — Control Center" active="overview" crumb={['Mission Control', 'Overview']}>
  <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight m-0 mb-1">SKM Mission Control</h1>
      <p class="text-sm opacity-60 m-0">One place to check your sites, databases and Cloudflare resources.</p>
    </div>
    <button id="reloadSnapshot" class="btn btn-outline btn-sm" type="button">↻ Reload snapshot</button>
  </div>

  <div class="flex gap-2 overflow-x-auto pb-2 mb-4" role="tablist" aria-label="Dashboard sections">
    <button class="btn btn-sm dashboard-tab" role="tab" aria-selected="true" data-tab="dashboard">📊 Dashboard</button>
    <button class="btn btn-sm btn-outline dashboard-tab" role="tab" aria-selected="false" data-tab="sites">🌐 Sites</button>
    <button class="btn btn-sm btn-outline dashboard-tab" role="tab" aria-selected="false" data-tab="infrastructure">☁️ Infrastructure</button>
    <button class="btn btn-sm btn-outline dashboard-tab" role="tab" aria-selected="false" data-tab="github">🐙 GitHub</button>
    <button class="btn btn-sm btn-outline dashboard-tab" role="tab" aria-selected="false" data-tab="integrations">🔌 Integrations</button>
    <button class="btn btn-sm btn-outline dashboard-tab" role="tab" aria-selected="false" data-tab="analytics">📈 Analytics</button>
  </div>

  <div id="snapshotStatus" class="alert mb-6" role="status" aria-live="polite"><span class="text-sm">Loading saved Cloudflare data…</span></div>

  <section data-dashboard-panel="dashboard" role="tabpanel" class="grid grid-cols-2 xl:grid-cols-4 gap-3 mb-6" aria-label="Resource totals">
    {[
      ['Pages projects', 'stat-pages', '—'], ['Workers', 'stat-workers', '—'],
      ['D1 databases', 'stat-d1', '—'], ['KV namespaces', 'stat-kv', '—'],
    ].map(([label, id, value]) => (
      <article class="card"><div class="card-body p-4">
        <div class="text-xs opacity-60">{label}</div><div id={id} class="text-3xl font-bold mt-1">{value}</div>
        <div class="text-xs opacity-50 mt-1">From the last saved account snapshot</div>
      </div></article>
    ))}
  </section>

  <section data-dashboard-panel="sites" role="tabpanel" class="card mb-6 hidden"><div class="card-body p-4 sm:p-5">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <div><h2 class="font-semibold m-0">🌐 Pages projects</h2><p class="text-xs opacity-60 mt-1 mb-0">Open a project to check the live site.</p></div>
      <span id="pagesCount" class="badge">0 projects</span>
    </div>
    <div id="pagesTable" class="state"><strong>Loading…</strong><span>Reading the saved Cloudflare snapshot.</span></div>
  </div></section>

  <section data-dashboard-panel="infrastructure" role="tabpanel" class="grid xl:grid-cols-2 gap-4 mb-6 hidden">
    <article class="card"><div class="card-body p-4 sm:p-5">
      <div class="flex items-center justify-between gap-2 mb-3"><h2 class="font-semibold m-0">⚙️ Workers</h2><span id="workersCount" class="badge">0</span></div>
      <div id="workersTable" class="state"><strong>Loading…</strong></div>
    </div></article>
    <article class="card"><div class="card-body p-4 sm:p-5">
      <div class="flex items-center justify-between gap-2 mb-3"><h2 class="font-semibold m-0">🗄️ D1 databases</h2><span id="d1Count" class="badge">0</span></div>
      <div id="d1Table" class="state"><strong>Loading…</strong></div>
    </div></article>
  </section>

  <section data-dashboard-panel="infrastructure" role="tabpanel" class="card mb-6 hidden"><div class="card-body p-4 sm:p-5">
    <div class="flex items-center justify-between gap-2 mb-3"><h2 class="font-semibold m-0">🧺 KV namespaces</h2><span id="kvCount" class="badge">0</span></div>
    <div id="kvTable" class="state"><strong>Loading…</strong></div>
  </div></section>

  <section data-dashboard-panel="github" role="tabpanel" class="card mb-6 hidden"><div class="card-body p-4 sm:p-5">
    <div class="flex items-center justify-between gap-3 mb-2"><h2 class="font-semibold m-0">🔗 GitHub source</h2><a class="btn btn-outline btn-xs" href="https://github.com/skmstudioservices-cyber/my-CMS-dashboard" target="_blank" rel="noopener noreferrer">Open repository ↗</a></div>
    <div id="sourceDetails" class="state"><strong>Deployment details not saved yet</strong><span>The next successful bridge deployment can add the source commit and workflow link here.</span></div>
  </div></section>

  <section data-dashboard-panel="integrations" role="tabpanel" class="card mb-6 hidden"><div class="card-body p-4 sm:p-5">
    <h2 class="font-semibold m-0 mb-2">🔌 Connected tools</h2>
    <p class="text-sm opacity-70 mb-4">Only verified API connections will be marked connected. These are the planned provider cards, not claims that credentials are already configured.</p>
    <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-3">
      {[
        ['🐙 GitHub','Repository, commits, Actions, issues and pull requests','Available through connected GitHub tools; app-level sync still needs implementation.'],
        ['☁️ Cloudflare','Pages, Workers, D1, KV and deployments','Saved snapshot currently available; upstream refresh automation still needs verification.'],
        ['📝 Notion','Pages, databases and tasks','MCP is available in this workspace; dashboard adapter is not connected yet.'],
        ['🔎 Google Search Console','Search clicks, impressions, CTR and position','OAuth/API connection required.'],
        ['🌐 Bing Webmaster Tools','Search performance and indexing','API connection required.'],
        ['📊 GA4','Traffic, engagement and conversions','Analytics property and OAuth/API connection required.'],
        ['📈 Sheets / exports','Chosen spreadsheet data sources','Connect only the specific sheet(s) intended as sources of truth.'],
        ['💰 Monetag / SEO tools','Revenue and SEO reports','API, export, or email parsing depends on each provider’s access.'],
        ['◇ Supabase / MCP','Connected databases and tools','Provider-specific read/write scopes must be verified.']
      ].map(([name, description, status]) => (
        <article class="rounded-xl border border-base-300 p-4">
          <h3 class="font-semibold m-0 mb-1">{name}</h3>
          <p class="text-sm opacity-70 m-0 mb-2">{description}</p>
          <p class="text-xs opacity-60 m-0">{status}</p>
        </article>
      ))}
    </div>
  </div></section>

  <section data-dashboard-panel="analytics" role="tabpanel" class="card mb-6 hidden"><div class="card-body p-4 sm:p-5">
    <h2 class="font-semibold m-0 mb-2">📈 Analytics & growth</h2>
    <div class="state"><strong>No verified analytics source connected to this dashboard yet</strong><span>GA4, Search Console, Bing, Monetag and SEO metrics will appear here only after their real APIs, authorized exports, or explicitly configured email reports have been connected. No fabricated traffic or earnings.</span></div>
  </div></section>

  <p class="text-xs opacity-50 mt-5">Read-only overview. Reloading reads the saved snapshot; it does not change Cloudflare resources or start a deployment.</p>
</Base>

<script>
  type PageProject = { name?: string; productionBranch?: string | null; domain?: string | null };
  type WorkerItem = { id?: string; modified?: string | null };
  type Database = { name?: string; uuid?: string; sizeKb?: number };
  type Namespace = { title?: string; id?: string };
  type Snapshot = {
    connected?: boolean; reason?: string; accountId?: string; generatedAt?: string;
    pages?: PageProject[]; workers?: WorkerItem[]; d1?: Database[]; kv?: Namespace[];
    source?: { repository?: string; branch?: string; commit?: string; message?: string; committedAt?: string; runUrl?: string };
  };
  const esc = (v: unknown) => String(v ?? '—').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c] as string));
  const setState = (id: string, title: string, detail = '') => {
    const el = document.getElementById(id);
    if (el) el.innerHTML = '<div class="state"><strong>' + esc(title) + '</strong>' + (detail ? '<span>' + esc(detail) + '</span>' : '') + '</div>';
  };
  const table = (id: string, columns: string[], rows: string[][]) => {
    const el = document.getElementById(id);
    if (!el) return;
    if (!rows.length) { setState(id, 'No items found', 'The snapshot did not include any items in this section.'); return; }
    el.className = 'overflow-x-auto';
    el.innerHTML = '<table class="table table-sm"><thead><tr>' + columns.map(c => '<th>' + esc(c) + '</th>').join('') + '</tr></thead><tbody>' +
      rows.map(row => '<tr>' + row.map(c => '<td>' + c + '</td>').join('') + '</tr>').join('') + '</tbody></table>';
  };
  const setText = (id: string, value: unknown) => { const el = document.getElementById(id); if (el) el.textContent = String(value ?? '—'); };
  async function loadSnapshot() {
    const status = document.getElementById('snapshotStatus');
    if (status) status.innerHTML = '<span class="text-sm">Loading saved Cloudflare data…</span>';
    try {
      const response = await fetch('/api/cf', { headers: { accept: 'application/json' }, cache: 'no-store' });
      const data = await response.json() as Snapshot;
      if (!response.ok || !data.connected) {
        if (status) status.innerHTML = '<span class="text-sm">⚠️ Cloudflare data is not connected: ' + esc(data.reason || 'No saved snapshot available.') + '</span>';
        ['pagesTable','workersTable','d1Table','kvTable','sourceDetails'].forEach(id => setState(id, 'Data unavailable', data.reason || 'Run the dashboard deployment workflow to save a snapshot.'));
        ['stat-pages','stat-workers','stat-d1','stat-kv'].forEach(id => setText(id, '—'));
        return;
      }
      const pages = data.pages || [], workers = data.workers || [], dbs = data.d1 || [], namespaces = data.kv || [];
      setText('stat-pages', pages.length); setText('stat-workers', workers.length); setText('stat-d1', dbs.length); setText('stat-kv', namespaces.length);
      setText('pagesCount', pages.length + (pages.length === 1 ? ' project' : ' projects'));
      setText('workersCount', workers.length); setText('d1Count', dbs.length); setText('kvCount', namespaces.length);
      const stamp = data.generatedAt ? new Date(data.generatedAt) : null;
      const validStamp = stamp && !Number.isNaN(stamp.getTime());
      const ageHours = validStamp ? (Date.now() - stamp.getTime()) / 3600000 : null;
      const stale = ageHours !== null && ageHours > 24;
      const when = validStamp ? stamp.toLocaleString() : 'time not recorded';
      if (status) {
        status.className = 'alert mb-6 ' + (stale ? 'alert-info' : '');
        status.innerHTML = '<span class="text-sm">' + (stale ? '⚠️ Snapshot may be old. ' : '✅ ') + 'Cloudflare connected · ' +
          pages.length + ' Pages · ' + workers.length + ' Workers · last saved ' + esc(when) +
          ' · account ' + esc(data.accountId || 'not recorded') + '</span>';
      }
      table('pagesTable', ['Project', 'Branch', 'Domain', 'Open'], pages.map(p => {
        const domain = String(p.domain || '');
        const safeDomain = /^[a-z0-9.-]+$/i.test(domain) ? domain : '';
        const open = safeDomain ? '<a class="btn btn-xs btn-outline" href="https://' + esc(safeDomain) + '" target="_blank" rel="noopener noreferrer">Visit ↗</a>' : '—';
        return ['<span class="font-medium">' + esc(p.name) + '</span>', esc(p.productionBranch || '—'), esc(domain || '—'), open];
      }));
      table('workersTable', ['Worker', 'Last updated'], workers.map(w => [esc(w.id), esc(w.modified ? new Date(w.modified).toLocaleString() : '—')]));
      table('d1Table', ['Database', 'Size'], dbs.map(d => [esc(d.name), typeof d.sizeKb === 'number' ? esc(d.sizeKb.toLocaleString() + ' KB') : '—']));
      table('kvTable', ['Namespace', 'ID'], namespaces.map(k => [esc(k.title), '<code class="text-xs">' + esc(k.id) + '</code>']));
      if (data.source?.commit) {
        const s = data.source;
        const repo = s.repository || 'skmstudioservices-cyber/my-CMS-dashboard';
        const commitUrl = 'https://github.com/' + repo + '/commit/' + encodeURIComponent(s.commit);
        const run = s.runUrl ? '<a class="btn btn-xs btn-outline" href="' + esc(s.runUrl) + '" target="_blank" rel="noopener noreferrer">Workflow ↗</a>' : '';
        const target = document.getElementById('sourceDetails');
        if (target) {
          target.className = 'text-sm flex flex-col gap-2';
          target.innerHTML = '<div><span class="text-xs opacity-60">Repository</span><div class="font-medium">' + esc(repo) + '</div></div>' +
            '<div><span class="text-xs opacity-60">Saved source commit</span><div><a class="underline" href="' + esc(commitUrl) + '" target="_blank" rel="noopener noreferrer">' + esc(String(s.commit).slice(0,7)) + ' · ' + esc(s.message || 'View commit') + ' ↗</a></div></div>' +
            '<div class="flex flex-wrap items-center gap-2"><span class="text-xs opacity-60">Branch: ' + esc(s.branch || 'main') + '</span>' + run + '</div>';
        }
      } else setState('sourceDetails', 'Deployment details not saved yet', 'The Cloudflare resource snapshot works. Add source-commit tracking in the bridge workflow to show the exact deployed commit here.');
    } catch (error) {
      if (status) status.innerHTML = '<span class="text-sm">❌ Could not load the saved snapshot. ' + esc(error instanceof Error ? error.message : error) + '</span>';
      ['pagesTable','workersTable','d1Table','kvTable'].forEach(id => setState(id, 'Could not load data', 'Check the /api/cf connection and try again.'));
    }
  }
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.dashboard-tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-dashboard-panel]'));
  function activateTab(name: string) {
    tabs.forEach(tab => {
      const selected = tab.dataset.tab === name;
      tab.setAttribute('aria-selected', String(selected));
      tab.classList.toggle('btn-outline', !selected);
      tab.classList.toggle('btn-primary', selected);
    });
    panels.forEach(panel => panel.classList.toggle('hidden', panel.dataset.dashboardPanel !== name));
  }
  tabs.forEach(tab => tab.addEventListener('click', () => activateTab(tab.dataset.tab || 'dashboard')));
  activateTab('dashboard');

  document.getElementById('reloadSnapshot')?.addEventListener('click', loadSnapshot);
  loadSnapshot();
</script>

---
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';
---
<Base title="Growth & Monetization — Nexus CMS" active="growth" crumb={['Mission Control', 'Growth &amp; Monetization']}>
  <h1 class="text-2xl font-bold tracking-tight m-0 mb-1">Growth &amp; Monetization</h1>
  <p class="opacity-60 text-sm m-0 mb-6">Traffic, search performance and monetization.</p>
  <Panel title="Traffic & audience" status="planned">
  <div class="state"><strong>Not connected</strong><span>Analytics integration not configured — no sample numbers shown.</span></div>
  </Panel>
<Panel title="Search performance" status="planned">
  <div class="state"><strong>Not connected</strong><span>GSC integration not configured.</span></div>
  </Panel>
<Panel title="Monetization" status="planned">
  <div class="state"><strong>Not connected</strong><span>Not configured.</span></div>
  </Panel>

</Base>

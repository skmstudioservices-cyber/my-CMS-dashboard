---
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';
---
<Base title="Site Management — Nexus CMS" active="sites" crumb={['Mission Control', 'Site Management']}>
  <h1 class="text-2xl font-bold tracking-tight m-0 mb-1">Site Management</h1>
  <p class="opacity-60 text-sm m-0 mb-6">Central registry of SKM Studio Network sites.</p>
  <Panel title="Registered sites" status="disconnected">
  <div class="state"><strong>Not connected</strong><span>Registry storage not wired yet — no sites are listed to avoid showing fabricated data.</span></div>
  </Panel>

</Base>

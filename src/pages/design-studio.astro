---
import Base from '../layouts/Base.astro';
const presets = [
 {id:'landing',name:'Landing page',blocks:[['hero','Build a website that works for you','A clear message, a useful offer, one next step.','Get started'],['features','Why choose us','Three reasons visitors should trust you.','Fast • Reliable • Simple'],['testimonials','What customers say','Real proof builds confidence.','Customer feedback'],['cta','Ready to get started?','Make the next step obvious.','Contact us']]},
 {id:'blog',name:'Blog / magazine',blocks:[['hero','Stories worth your time','Guides, ideas and practical answers.','Explore articles'],['categories','Explore topics','Find the information you need.','News • Guides • Reviews'],['posts','Latest articles','Fresh stories from the editor.','Article cards']]},
 {id:'directory',name:'Local directory',blocks:[['hero','Find trusted places near you','Explore useful local businesses and services.','Search listings'],['search','What are you looking for?','Search by service, category or location.','Search'],['categories','Browse categories','Start with a popular category.','Restaurants • Doctors • Hotels'],['listings','Popular near you','Useful places selected for you.','Business cards']]},
 {id:'shop',name:'Online shop',blocks:[['hero','Good things, thoughtfully selected','Discover products made for everyday life.','Shop now'],['products','Featured products','Popular picks from our store.','Product cards'],['cta','A little something for you','Highlight an offer or collection.','Explore offers']]},
 {id:'restaurant',name:'Restaurant',blocks:[['hero','Good food. Great company.','A place to slow down and enjoy.','View menu • Reserve'],['menu','From our kitchen','A few guest favourites.','Menu items and prices'],['gallery','A look inside','Food, space and moments.','Photo gallery'],['contact','Find us','Opening hours and location.','Address • Phone • Hours']]},
 {id:'booking',name:'Booking / services',blocks:[['hero','Book a service that fits your day','Choose a service, a time and you are set.','Book now'],['services','Choose your service','Clear options and transparent pricing.','Service • Duration • Price'],['steps','How booking works','Three simple steps.','Choose • Schedule • Confirm'],['cta','Find your time','Book online in a few clicks.','Book now']]}
];
---
<Base title="Visual Design Studio — Nexus CMS" active="design-studio" crumb={['Workspace','Visual Design Studio']}>
 <div class="head"><div><small>PAGE BUILDER</small><h1>Visual Design Studio</h1><p>Build page layouts visually. Export a portable design spec for any framework.</p></div><div class="actions"><button id="save">Save draft</button><button id="export">Export JSON</button><button class="primary" id="prompt">Copy AI prompt</button></div></div>
 <div class="presets">{presets.map(p=><button class="preset" data-preset={p.id}><b>{p.name}</b><small>Load preset</small></button>)}</div>
 <div class="toolbar"><span>Live preview</span><div><button data-view="desktop" class="on">Desktop</button><button data-view="tablet">Tablet</button><button data-view="mobile">Mobile</button></div></div>
 <div class="builder">
  <aside class="panel"><h3>Add section</h3><div class="add-grid">{['hero','features','search','categories','listings','products','services','posts','testimonials','gallery','menu','steps','pricing','faq','contact','cta'].map(t=><button data-add={t}>＋ {t}</button>)}</div><h3>Page details</h3><label>Page name<input id="pageName" value="Untitled page"></label><label>Page type<select id="pageType"><option>Landing page</option><option>Blog</option><option>Directory</option><option>Shop</option><option>Restaurant</option><option>Booking</option></select></label></aside>
  <section class="preview"><div class="stage"><div id="canvas" class="canvas"></div></div><footer><span id="count">0 sections</span><span>Click section to edit · use arrows to reorder</span></footer></section>
  <aside class="panel inspector"><nav><button class="on" data-tab="content">Content</button><button data-tab="style">Style</button><button data-tab="global">Global</button></nav>
   <div id="tab-content"><h3>Section content</h3><label>Heading<input id="heading"></label><label>Subheading<textarea id="subheading" rows="3"></textarea></label><label>Body / button label<textarea id="body" rows="2"></textarea></label><div class="arrows"><button id="up">↑ Move up</button><button id="down">↓ Move down</button></div><button id="remove" class="danger">Delete section</button></div>
   <div id="tab-style" class="hide"><h3>Section style</h3><label>Background<input type="color" id="sectionBg" value="#ffffff"></label><label>Text<input type="color" id="sectionText" value="#172033"></label><label>Spacing<select id="spacing"><option>Compact</option><option selected>Normal</option><option>Airy</option></select></label></div>
   <div id="tab-global" class="hide"><h3>Global design tokens</h3><label>Primary<input type="color" id="primary" value="#2563eb"></label><label>Accent<input type="color" id="accent" value="#0f766e"></label><label>Page background<input type="color" id="background" value="#ffffff"></label><label>Text<input type="color" id="textColor" value="#172033"></label><label>Font<select id="font"><option>System</option><option>Arial</option><option>Georgia</option><option>Inter</option><option>Roboto</option></select></label><label>Corner style<select id="radius"><option>Soft</option><option>Sharp</option><option>Rounded</option></select></label><label>Content width<select id="width"><option value="1100">Wide</option><option value="920">Standard</option><option value="760">Narrow</option></select></label></div>
  </aside>
 </div>
 <p class="note"><b>Portable by design:</b> designs are stored as framework-neutral JSON. The editor uses native controls and lightweight JavaScript—no paid builder runtime or heavy drag-and-drop dependency.</p>
</Base>
<style>
.head{display:flex;justify-content:space-between;gap:15px;align-items:flex-start;margin-bottom:16px}.head h1{font-size:25px;font-weight:800;margin:3px 0}.head small{font-size:10px;color:var(--color-primary);font-weight:800;letter-spacing:.15em}.head p{font-size:12px;color:var(--color-muted);margin:0}.actions{display:flex;gap:6px;flex-wrap:wrap}.actions button,.panel button,.toolbar button{border:1px solid var(--color-base-300);background:var(--color-base-100);padding:7px 9px;border-radius:7px;font-size:11px;cursor:pointer;color:var(--color-base-content)}.actions .primary{background:var(--color-primary);color:white}.presets{display:flex;gap:7px;overflow:auto;margin:12px 0}.preset{min-width:118px;text-align:left;border:1px solid var(--color-base-300);border-radius:8px;background:var(--color-base-100);padding:8px;cursor:pointer}.preset b,.preset small{display:block}.preset b{font-size:11px}.preset small{font-size:9px;color:var(--color-muted);margin-top:3px}.preset.active{border-color:var(--color-primary)}.toolbar{display:flex;justify-content:space-between;align-items:center;padding:9px 12px;background:var(--color-base-100);border:1px solid var(--color-base-300);border-bottom:0;border-radius:10px 10px 0 0;font-size:11px;font-weight:700}.toolbar button.on,.panel nav button.on{background:var(--color-primary);color:white}.builder{display:grid;grid-template-columns:180px minmax(250px,1fr) 220px;gap:10px;min-height:600px}.panel,.preview{background:var(--color-base-100);border:1px solid var(--color-base-300);padding:11px;border-radius:9px;min-width:0}.panel h3{font-size:11px;text-transform:uppercase;letter-spacing:.07em;margin:5px 0 12px}.add-grid{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-bottom:22px}.panel .add-grid button{font-size:10px;text-align:left;padding:6px 4px}.panel label{display:block;font-size:10px;font-weight:700;margin:12px 0}.panel input:not([type=color]),.panel textarea,.panel select{display:block;width:100%;padding:7px;border:1px solid var(--color-base-300);border-radius:6px;background:var(--color-base-100);color:var(--color-base-content);margin-top:5px;font:inherit;font-size:11px}.panel input[type=color]{display:block;width:100%;height:32px;margin-top:5px}.panel nav{display:flex;gap:4px;margin-bottom:12px}.panel nav button{flex:1}.panel .danger{color:#b91c1c;margin-top:8px}.arrows{display:flex;gap:5px}.stage{background:#e9edf3;padding:16px;min-height:550px;overflow:auto;display:flex;justify-content:center}.canvas{width:100%;max-width:1100px;min-height:500px;background:var(--page-bg,#fff);color:var(--page-text,#172033);font-family:var(--page-font,system-ui);border-radius:var(--page-radius,8px);overflow:hidden}.canvas.tablet{width:768px}.canvas.mobile{width:375px}.section{padding:46px 7%;border:2px solid transparent;position:relative;cursor:pointer}.section.selected{border-color:var(--color-primary)}.section h2{font-size:clamp(20px,3vw,32px);font-weight:800;line-height:1.15;margin:0 0 10px}.section p{font-size:13px;line-height:1.7;max-width:620px;margin:0 0 12px;opacity:.8}.section span{font-size:10px;display:inline-block;padding:9px 14px;border-radius:var(--page-radius);background:var(--page-primary);color:white}.section em{position:absolute;right:10px;top:7px;font-size:8px;opacity:.45;text-transform:uppercase}.section.compact{padding-top:24px;padding-bottom:24px}.section.airy{padding-top:68px;padding-bottom:68px}.preview footer{display:flex;justify-content:space-between;font-size:10px;color:var(--color-muted);padding:9px 2px}.hide{display:none}.note{padding:11px;border:1px solid var(--color-base-300);border-radius:8px;font-size:11px;color:var(--color-muted);margin-top:12px}@media(max-width:1050px){.builder{grid-template-columns:160px minmax(220px,1fr)}.inspector{grid-column:1/-1}}@media(max-width:680px){.head{display:block}.actions{margin-top:12px}.builder{grid-template-columns:1fr}.preview{order:1}.panel:first-child{order:2}.inspector{order:3}.stage{padding:8px}.section{padding:30px 6%}}
</style>
<script>
type B={id:string,type:string,title:string,subtitle:string,body:string,bg:string,text:string,spacing:string};
type T={primary:string,accent:string,background:string,text:string,font:string,radius:string,width:string};
const $=(id:string)=>document.getElementById(id) as HTMLInputElement;
const canvas=$('canvas');
const presetData=[];
let blocks:B[]=[];let selected=-1;let view='desktop';
let tokens:T={primary:'#2563eb',accent:'#0f766e',background:'#ffffff',text:'#172033',font:'System',radius:'Soft',width:'1100'};
const make=(type:string,title?:string,subtitle?:string,body?:string):B=>({id:crypto.randomUUID(),type,title:title||type[0].toUpperCase()+type.slice(1),subtitle:subtitle||'Add a short supporting line.',body:body||'Add your content here.',bg:'#ffffff',text:'#172033',spacing:'Normal'});
const presets=[
 {id:'landing',name:'Landing page',blocks:[['hero','Build a website that works for you','A clear message, a useful offer, one next step.','Get started'],['features','Why choose us','Three reasons visitors should trust you.','Fast • Reliable • Simple'],['testimonials','What customers say','Real proof builds confidence.','Customer feedback'],['cta','Ready to get started?','Make the next step obvious.','Contact us']]},
 {id:'blog',name:'Blog / magazine',blocks:[['hero','Stories worth your time','Guides, ideas and practical answers.','Explore articles'],['categories','Explore topics','Find the information you need.','News • Guides • Reviews'],['posts','Latest articles','Fresh stories from the editor.','Article cards']]},
 {id:'directory',name:'Local directory',blocks:[['hero','Find trusted places near you','Explore useful local businesses and services.','Search listings'],['search','What are you looking for?','Search by service, category or location.','Search'],['categories','Browse categories','Start with a popular category.','Restaurants • Doctors • Hotels'],['listings','Popular near you','Useful places selected for you.','Business cards']]},
 {id:'shop',name:'Online shop',blocks:[['hero','Good things, thoughtfully selected','Discover products made for everyday life.','Shop now'],['products','Featured products','Popular picks from our store.','Product cards'],['cta','A little something for you','Highlight an offer or collection.','Explore offers']]},
 {id:'restaurant',name:'Restaurant',blocks:[['hero','Good food. Great company.','A place to slow down and enjoy.','View menu • Reserve'],['menu','From our kitchen','A few guest favourites.','Menu items and prices'],['gallery','A look inside','Food, space and moments.','Photo gallery'],['contact','Find us','Opening hours and location.','Address • Phone • Hours']]},
 {id:'booking',name:'Booking / services',blocks:[['hero','Book a service that fits your day','Choose a service, a time and you are set.','Book now'],['services','Choose your service','Clear options and transparent pricing.','Service • Duration • Price'],['steps','How booking works','Three simple steps.','Choose • Schedule • Confirm'],['cta','Find your time','Book online in a few clicks.','Book now']]}
];
function render(){const c=canvas as HTMLElement;c.style.setProperty('--page-primary',tokens.primary);c.style.setProperty('--page-bg',tokens.background);c.style.setProperty('--page-text',tokens.text);c.style.setProperty('--page-font',tokens.font==='System'?'system-ui':tokens.font);c.style.setProperty('--page-radius',tokens.radius==='Sharp'?'2px':tokens.radius==='Rounded'?'22px':'8px');c.style.maxWidth=tokens.width+'px';c.innerHTML='';
 blocks.forEach((b,i)=>{const s=document.createElement('section');s.className='section '+b.spacing.toLowerCase()+(i===selected?' selected':'');s.style.background=b.bg;s.style.color=b.text;s.tabIndex=0;const tag=document.createElement('em');tag.textContent=b.type;s.append(tag);const h=document.createElement('h2');h.textContent=b.title;s.append(h);const p=document.createElement('p');p.textContent=b.subtitle;s.append(p);const a=document.createElement('span');a.textContent=b.body;s.append(a);s.addEventListener('click',()=>select(i));c.append(s)});
 $('count').textContent=blocks.length+' sections'}
function select(i:number){selected=i;const b=blocks[i];$('heading').value=b?.title||'';$('subheading').value=b?.subtitle||'';$('body').value=b?.body||'';$('sectionBg').value=b?.bg||'#ffffff';$('sectionText').value=b?.text||'#172033';$('spacing').value=b?.spacing||'Normal';render()}
function update(){if(selected<0)return;Object.assign(blocks[selected],{title:$('heading').value,subtitle:$('subheading').value,body:$('body').value});render()}
['heading','subheading','body'].forEach(id=>$(id).addEventListener('input',update));
$('sectionBg').addEventListener('input',()=>{if(selected>=0){blocks[selected].bg=$('sectionBg').value;render()}});
$('sectionText').addEventListener('input',()=>{if(selected>=0){blocks[selected].text=$('sectionText').value;render()}});
$('spacing').addEventListener('change',()=>{if(selected>=0){blocks[selected].spacing=$('spacing').value;render()}});
document.querySelectorAll('[data-preset]').forEach(el=>el.addEventListener('click',()=>{const p=presets.find(x=>x.id===(el as HTMLElement).dataset.preset);if(!p)return;blocks=p.blocks.map(b=>make(b[0],b[1],b[2],b[3]));selected=0;$('pageType').value=p.name;document.querySelectorAll('.preset').forEach(x=>x.classList.toggle('active',x===el));select(0)}));
document.querySelectorAll('[data-add]').forEach(el=>el.addEventListener('click',()=>{blocks.push(make((el as HTMLElement).dataset.add!));select(blocks.length-1)}));
document.querySelectorAll('[data-view]').forEach(el=>el.addEventListener('click',()=>{view=(el as HTMLElement).dataset.view!;canvas.classList.toggle('tablet',view==='tablet');canvas.classList.toggle('mobile',view==='mobile');document.querySelectorAll('[data-view]').forEach(x=>x.classList.toggle('on',x===el))}));
document.querySelectorAll('[data-tab]').forEach(el=>el.addEventListener('click',()=>{const t=(el as HTMLElement).dataset.tab!;['content','style','global'].forEach(k=>$('tab-'+k).classList.toggle('hide',k!==t));document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('on',x===el))}));
$('up').addEventListener('click',()=>{if(selected>0){[blocks[selected-1],blocks[selected]]=[blocks[selected],blocks[selected-1]];select(selected-1)}});
$('down').addEventListener('click',()=>{if(selected>=0&&selected<blocks.length-1){[blocks[selected+1],blocks[selected]]=[blocks[selected],blocks[selected+1]];select(selected+1)}});
$('remove').addEventListener('click',()=>{if(selected>=0){blocks.splice(selected,1);selected=-1;render()}});
const tokenIds=['primary','accent','background','textColor','font','radius','width'];
function sync(){tokens={primary:$('primary').value,accent:$('accent').value,background:$('background').value,text:$('textColor').value,font:$('font').value,radius:$('radius').value,width:$('width').value};render()}
tokenIds.forEach(id=>$(id).addEventListener('input',sync));
function spec(){return {schemaVersion:'1.0',name:$('pageName').value,pageType:$('pageType').value,framework:'portable',tokens,blocks:blocks.map((b,i)=>({...b,order:i+1})),responsive:['desktop','tablet','mobile']}}
$('save').addEventListener('click',()=>{localStorage.setItem('nexus-design-studio-v1',JSON.stringify(spec()));alert('Draft saved in this browser.')});
$('export').addEventListener('click',()=>{const a=document.createElement('a');const u=URL.createObjectURL(new Blob([JSON.stringify(spec(),null,2)],{type:'application/json'}));a.href=u;a.download='nexus-page-design.json';a.click();URL.revokeObjectURL(u)});
$('prompt').addEventListener('click',async()=>{const p='Build this page in the target repository and framework. Keep the content, order, tokens, responsive behavior and accessibility. Use lightweight original components; do not add paid dependencies. Source of truth:\n'+JSON.stringify(spec(),null,2);try{await navigator.clipboard.writeText(p);alert('AI implementation prompt copied.')}catch{alert('Clipboard unavailable. Export the JSON instead.')}});
try{const saved=JSON.parse(localStorage.getItem('nexus-design-studio-v1')||'null');if(saved){blocks=saved.blocks||[];tokens={...tokens,...saved.tokens};$('pageName').value=saved.name||'Untitled page';}}catch{}
if(!blocks.length)blocks=presets[0].blocks.map(b=>make(b[0],b[1],b[2],b[3]));selected=blocks.length?0:-1;if(selected>=0)select(0);else render();
</script>
